{
  "name": "@collagility/types",
  "version": "0.1.6",
  "private": true,
  "description": "Shared domain types and core models for Collagility",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --build",
    "dev": "tsc --build --watch",
    "lint": "eslint src/**/*.ts",
    "test": "vitest run",
    "clean": "rimraf dist *.tsbuildinfo"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
