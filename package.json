{
  "name": "collagility-monorepo",
  "version": "0.1.4",
  "private": true,
  "type": "module",
  "bin": {
    "collagility": "apps/cli/dist/main.js"
  },
  "description": "The Multiplayer Workspace for AI Coding Agents - Monorepo Root",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "collagility": "node ./apps/cli/dist/index.js",
    "format": "prettier --write \"**/*.{ts,js,json,md}\"",
    "clean": "turbo run clean"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/ws": "^8.5.13",
    "@typescript-eslint/eslint-plugin": "^8.18.1",
    "@typescript-eslint/parser": "^8.18.1",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "rimraf": "^6.0.1",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "ws": "^8.18.0",
    "zod": "^3.24.1"
  }
}
