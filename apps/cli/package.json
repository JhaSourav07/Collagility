{
  "name": "collagility",
  "version": "0.1.3",
  "publishConfig": {
    "access": "public"
  },
  "description": "Terminal CLI application for Collagility host and participant sessions",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JhaSourav07/Collagility.git",
    "directory": "apps/cli"
  },
  "homepage": "https://github.com/JhaSourav07/Collagility#readme",
  "bugs": {
    "url": "https://github.com/JhaSourav07/Collagility/issues"
  },
  "type": "module",
  "bin": {
    "collagility": "dist/main.js"
  },
  "main": "./dist/main.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --build && node ./scripts/bundle.js",
    "bundle": "node ./scripts/bundle.js",
    "package": "node ./scripts/bundle.js && node ./scripts/package.js",
    "dev": "tsc --build --watch",
    "start": "node ./dist/index.js",
    "host": "node ./dist/index.js start",
    "lint": "eslint src/**/*.ts",
    "test": "vitest run",
    "clean": "rimraf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@collagility/adapters": "workspace:*",
    "@collagility/protocol": "workspace:*",
    "@collagility/renderer": "workspace:*",
    "@collagility/sdk": "workspace:*",
    "@collagility/server": "workspace:*",
    "@collagility/stream": "workspace:*",
    "@collagility/types": "workspace:*",
    "@fastify/websocket": "^11.0.1",
    "chalk": "^5.4.1",
    "commander": "^13.0.0",
    "fastify": "^5.2.0",
    "ink": "^5.2.1",
    "ink-text-input": "^6.0.0",
    "pino": "^9.6.0",
    "react": "^18.3.1",
    "ws": "^8.18.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/ws": "^8.5.13",
    "@yao-pkg/pkg": "^5.15.1",
    "esbuild": "^0.24.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
