{
  "name": "@collagility/cli",
  "version": "0.1.0-alpha.6",
  "private": true,
  "description": "Terminal CLI application for Collagility host and participant sessions",
  "type": "module",
  "bin": {
    "collagility": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc --build",
    "bundle": "node ./scripts/bundle.js",
    "package": "node ./scripts/bundle.js && node ./scripts/package.js",
    "dev": "tsc --build --watch",
    "start": "node ./dist/index.js",
    "lint": "eslint src/**/*.ts",
    "test": "vitest run",
    "clean": "rimraf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@collagility/adapters": "workspace:*",
    "@collagility/protocol": "workspace:*",
    "@collagility/sdk": "workspace:*",
    "@collagility/server": "workspace:*",
    "@collagility/stream": "workspace:*",
    "@collagility/types": "workspace:*",
    "chalk": "^5.4.1",
    "commander": "^13.0.0",
    "pino": "^9.6.0",
    "ws": "^8.18.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/ws": "^8.5.13",
    "@yao-pkg/pkg": "^5.15.1",
    "esbuild": "^0.24.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
