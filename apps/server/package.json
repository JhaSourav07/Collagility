{
  "name": "@collagility/server",
  "version": "0.1.1",
  "private": true,
  "description": "Fastify WebSocket relay control plane server for Collagility",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc --build",
    "dev": "tsc --build --watch",
    "start": "node ./dist/index.js",
    "lint": "eslint src/**/*.ts",
    "test": "vitest run",
    "clean": "rimraf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@collagility/protocol": "workspace:*",
    "@collagility/stream": "workspace:*",
    "@collagility/types": "workspace:*",
    "@fastify/websocket": "^11.0.1",
    "fastify": "^5.2.0",
    "pino": "^9.6.0",
    "ws": "^8.18.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/ws": "^8.5.13",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
